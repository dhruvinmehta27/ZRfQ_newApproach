{
  "name": "ZRfQ_newApproach",
  "version": "1.0.0",
  "description": "CAP + Fiori Elements RFQ management – BTP CF eu10, proxying SAP C4C /cust/v1/zrfq",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/http-client": "^4.6.0",
    "@sap-cloud-sdk/util": "^4.6.0",
    "@sap/cds": "^9",
    "@sap/xsenv": ">=3.3.2 <3.3.3",
    "@sap/xssec": "^4.13.0",
    "axios": "^1.7.0",
    "hdb": "^2.27.1",
    "passport": "^0.7.0"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --open",
    "build:cf": "npx cds build --production"
  },
  "cds": {
    "requires": {
      "auth": {
        "[development]": { "kind": "dummy" },
        "[production]": { "kind": "xsuaa" }
      }
    },
    "[production]": {
      "log": {
        "format": "json",
        "level": "info"
      }
    }
  }
}
